<Window x:Class="LethelModHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lethe Mod Helper" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
     <Window.Resources>
        <!-- 全局右键复制菜单 -->
        <ContextMenu x:Key="CopyContextMenu">
            <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
            <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
        </ContextMenu>

        <!-- 右键菜单 -->
        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="📁 新建 Buff" Click="CreateNewBuff_Click"/>
        </ContextMenu>

        <!-- 让所有只读 TextBox 都有右键菜单 -->
        <Style TargetType="TextBox">
            <Setter Property="ContextMenu" Value="{StaticResource CopyContextMenu}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="ContextMenu" Value="{StaticResource CopyContextMenu}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶部工具栏 ========== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenModButton" 
                    Content="📂 打开Mod" 
                    Width="120" 
                    Height="32" 
                    Click="OpenModButton_Click"/>

            <Button x:Name="RefreshButton" 
                    Content="🔄 刷新" 
                    Width="80" 
                    Height="32" 
                    Margin="10,0,0,0" 
                    Click="RefreshButton_Click"/>

            <TextBox x:Name="StatusTextBlock" 
                 Text="未打开任何Mod" 
                 IsReadOnly="True"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center" 
                 Margin="20,0,0,0"
                 FontSize="13"
                 Cursor="IBeam"
                 IsTabStop="False"
                 TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- ========== 主区域：左侧文件树 + 右侧内容 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：文件树 -->
            <Border Grid.Column="0" 
                    BorderBrush="#ccc" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="5">
                <TreeView x:Name="FileTreeView" 
                          SelectedItemChanged="FileTreeView_SelectedItemChanged"
                          MouseRightButtonDown="FileTreeView_MouseRightButtonDown">
                    <TreeViewItem Header="(未加载)" IsExpanded="True"/>
                </TreeView>
            </Border>

            <!-- 右侧：内容显示区 -->
            <Border Grid.Column="1" 
                    BorderBrush="#ccc" 
                    BorderThickness="1,1,1,1" 
                    CornerRadius="4" 
                    Margin="10,0,0,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 文件名标题 -->
                    <TextBox Grid.Row="0" 
                         x:Name="FileTitleTextBlock" 
                         Text="请选择一个文件" 
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         FontWeight="Bold" 
                         FontSize="14" 
                         Margin="0,0,0,10"
                         Cursor="IBeam"
                         IsTabStop="False"/>

                    <!-- 内容区域（滚动） -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContentPanel">
                            <TextBox Text="选择左侧文件查看内容" 
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="Gray" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center" 
                                 Margin="0,50,0,0"
                                 FontSize="16"
                                 Cursor="IBeam"
                                 IsTabStop="False"
                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBox x:Name="FooterStatusTextBlock" 
                 Text="就绪"
                 IsReadOnly="True"
                 Background="Transparent"
                 BorderThickness="0"
                 Cursor="IBeam"
                 IsTabStop="False"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    
</Window>